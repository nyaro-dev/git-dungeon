# Copier en .env.local. Aucune de ces variables n'est requise avant le WE 1 (ingestion).

# GitHub REST API — token serveur (fine-grained, accès public en lecture seule suffit)
GITHUB_TOKEN=

# Narrateur IA (WE 4)
GROQ_API_KEY=
DEEPSEEK_API_KEY=

# Supabase (WE 4) — serveur uniquement, ne jamais préfixer en NEXT_PUBLIC_
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Sel pour hacher les IP du quota
QUOTA_SALT=

# URL publique du site (OG, liens de partage)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
